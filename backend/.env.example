PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Pilihan mode penyimpanan: 'auto' | 'supabase' | 'memory'
# 'auto' akan memakai Supabase jika SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY terisi,
# atau fallback ke in-memory saat pengembangan lokal tanpa koneksi Supabase.
STORAGE_MODE=auto

# Kredensial Supabase (Settings -> API di dashboard Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
